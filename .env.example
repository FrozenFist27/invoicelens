# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
TESSERACT_CMD=            # e.g. C:\Program Files\Tesseract-OCR\tesseract.exe on Windows; blank on Linux
REVIEW_THRESHOLD=0.7
MAX_RETRIES=2
DEMO_MODE=false
DEMO_DAILY_DOC_LIMIT=20
DEMO_MAX_PAGES=3
# Optional alternative provider (kept for the abstraction; not required)
GEMINI_API_KEY=
